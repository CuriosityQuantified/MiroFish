# ===== LLM Provider Configuration =====
# Provider: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# ===== Anthropic Configuration (default) =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Custom base URL (e.g. for proxy). Omit to use Anthropic's default API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Model for swarm agents (high volume, fast/cheap): Haiku 4.5
LLM_SWARM_MODEL=claude-haiku-4-5-20251001
# Model for orchestration & report generation: Sonnet 4.6
LLM_ORCHESTRATION_MODEL=claude-sonnet-4-6

# ===== OpenAI Configuration (alternative) =====
# To use OpenAI instead, set LLM_PROVIDER=openai and configure:
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ===== Knowledge Graph Configuration (Graphiti + Kuzu) =====
# Embedded graph database — no external service or API key required.
# Default path: data/kuzu_graph/ (relative to project root)
# KUZU_DB_PATH=data/kuzu_graph

# Optional: OpenAI-compatible API for vector embeddings (improves semantic search quality)
# If not set, graph still works but without vector similarity search.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Zep Cloud (LEGACY — optional fallback) =====
# No longer required. Graphiti + Kuzu is the default graph backend.
# ZEP_API_KEY=your_zep_api_key_here

# ===== Accelerated LLM Configuration (Optional) =====
# Note: If not using accelerated config, do not include the following entries in the env file
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here

# ============= Social Simulation (Optional) =================
# Only needed if running Twitter/Reddit simulations.
# Requires: pip install -r backend/requirements-simulation.txt
# No additional env vars needed — simulation uses the same LLM config above.
